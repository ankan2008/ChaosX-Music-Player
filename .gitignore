# Dependencies and build output
node_modules/
dist/
dist-electron/
release/
*.tsbuildinfo

# Third-party binaries, each of which is over GitHub's 100 MB per-file limit.
# See the README: these are fetched into resources/, not committed.
resources/mpv/*.exe
resources/ffmpeg/*.exe
resources/**/*.dll

# The sample wallpapers and live clips ARE part of the app — they are what ships in the
# installer and what a fresh clone needs, so they are committed like any other asset.
# The largest is 22.6 MB, well inside GitHub's 50 MB warning and 100 MB reject limits.
#
# One exception: this file was committed once, is byte-identical to
# resources/wallpapers/katana.jpg, and nothing in the codebase references it. Dead
# weight, so it stays out.
public/brand/wallpaper.jpg

# Local scratch, agent state and one-off dumps — never part of the app
.shots/
.tmp/
.refs/
.claude/
tomakezip/
tomakezip.zip
*.log
typecheck_out.txt
MusicTree.txt
x.png
connected-components

# Credentials, if any are ever added
.env
.env.*

# Bundled interface assets that stay local and are not redistributed here.
src/assets/fonts/*.otf
src/assets/fonts/*.ttf
src/assets/fonts/*.woff
src/assets/fonts/*.woff2
