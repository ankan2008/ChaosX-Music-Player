# Dependencies and build output
node_modules/
dist/
dist-electron/
release/
*.tsbuildinfo

# Third-party binaries, each of which is over GitHub's 100 MB per-file limit.
# See the README: these are fetched into resources/, not committed.
resources/mpv/*.exe
resources/ffmpeg/*.exe
resources/**/*.dll

# Bundled sample wallpapers and live video — third-party artwork and footage that
# nobody here holds a redistribution licence for. They stay on disk so this machine's
# app and installer keep working exactly as before, but they must never be published.
# Without these rules `git add -A` stages all 21 of them.
#
# NOTE the consequence: `public/brand/wallpapers/train_upscaled.jpg` is the default
# backdrop the code asks for (playerStore.ts:391, index.html:58, SetupWizard.tsx:148),
# so a fresh clone has no file at that path. Either drop a wallpaper you own there, or
# repoint the default at something generated before anyone builds from the repository.
resources/wallpapers/
public/brand/wallpapers/
# A stray duplicate of one of the above, tracked before this rule existed.
public/brand/wallpaper.jpg

# Local scratch, agent state and one-off dumps — never part of the app
.shots/
.tmp/
.refs/
.claude/
tomakezip/
tomakezip.zip
*.log
typecheck_out.txt
MusicTree.txt
x.png
connected-components

# Credentials, if any are ever added
.env
.env.*

# Typeface files. Both faces the app uses are licensed to the person who bought
# them, not to the project, so they are not redistributed here — drop your own
# copies into this folder and the CSS picks them up, or let it fall through to
# system-ui. See src/assets/fonts/README.md.
src/assets/fonts/*.otf
src/assets/fonts/*.ttf
src/assets/fonts/*.woff
src/assets/fonts/*.woff2
